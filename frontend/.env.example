# Copy to .env.local and adjust for local development. Never commit .env.local.
#
# Base URL the frontend calls the backend at -- used both by Server Components
# (fetched from the Next.js server) and Client Components (fetched from the
# browser). For local development these are the same address; a production
# deployment behind a reverse proxy may need different URLs and would split this
# into a server-only and a NEXT_PUBLIC_ variable at that point.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
