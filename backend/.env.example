# Copy to .env and adjust for local development. Never commit .env.
#
# All variables are prefixed HEATPILOT_ (see app/core/config.py) and are optional —
# every setting has a safe default for local development.

HEATPILOT_ENVIRONMENT=local
HEATPILOT_DEBUG=true

HEATPILOT_LOG_LEVEL=INFO
HEATPILOT_LOG_JSON=false

# Comma-separated list of allowed frontend origins.
HEATPILOT_CORS_ORIGINS=http://localhost:3000

# Matches the docker-compose.yml `db` service. Must use the asyncpg driver.
HEATPILOT_DATABASE_URL=postgresql+asyncpg://heatpilot:heatpilot@localhost:5432/heatpilot
HEATPILOT_DATABASE_ECHO=false
