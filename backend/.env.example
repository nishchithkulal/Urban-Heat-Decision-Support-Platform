# Copy to .env and adjust for local development. Never commit .env.
#
# All variables are prefixed HEATPILOT_ (see app/core/config.py) and are optional —
# every setting has a safe default for local development.

HEATPILOT_ENVIRONMENT=local
HEATPILOT_DEBUG=true

HEATPILOT_LOG_LEVEL=INFO
HEATPILOT_LOG_JSON=false

# Comma-separated list of allowed frontend origins.
HEATPILOT_CORS_ORIGINS=http://localhost:3000

# Matches the docker-compose.yml `db` service. Must use the asyncpg driver.
HEATPILOT_DATABASE_URL=postgresql+asyncpg://heatpilot:heatpilot@localhost:5432/heatpilot
HEATPILOT_DATABASE_ECHO=false

# Generate a real value for anything beyond local development, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to start with this default when HEATPILOT_ENVIRONMENT=production.
HEATPILOT_JWT_SECRET_KEY=insecure-local-dev-secret-change-me
HEATPILOT_ACCESS_TOKEN_EXPIRE_MINUTES=15
HEATPILOT_REFRESH_TOKEN_EXPIRE_DAYS=7

HEATPILOT_HTTP_CLIENT_TIMEOUT_SECONDS=5.0
# No API key required.
HEATPILOT_WEATHER_PROVIDER_BASE_URL=https://api.open-meteo.com/v1/forecast
